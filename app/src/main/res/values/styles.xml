<resources>

    <style name="Widget.Sanin.AppWidget.Container" parent="android:Widget">
        <item name="android:id">@android:id/background</item>
        <item name="android:background">?android:attr/colorBackground</item>
    </style>

    <style name="Widget.Sanin.AppWidget.InnerView" parent="android:Widget">
        <item name="android:background">?android:attr/colorBackground</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <!-- Transparent Material theme for CloudStreamSettingsActivity: a host for a
         plugin's own settings UI (a BottomSheetDialogFragment). MaterialComponents
         parent supplies the bottomSheetDialogTheme attrs the plugin relies on; the
         translucent window lets the sheet float over a dim backdrop. -->
    <style name="Theme.CloudStreamSettings" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>