<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:descendantFocusability="afterDescendants"
    android:focusable="true"
    tools:context=".cloudstream.TmdbWatchActivity">

    <ImageView
        android:id="@+id/mediaBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        tools:ignore="ContentDescription" />

    <View
        android:id="@+id/mediaBgGradient"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_rtl_dark"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/tmdbWatchLogo"
        android:layout_width="wrap_content"
        android:layout_height="80dp"
        android:layout_gravity="start"
        android:layout_marginStart="24dp"
        android:layout_marginTop="120dp"
        android:adjustViewBounds="true"
        android:scaleType="fitStart"
        android:visibility="gone"
        tools:ignore="ContentDescription"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tmdbWatchTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginStart="24dp"
        android:layout_marginTop="130dp"
        android:fontFamily="@font/poppins_bold"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tmdbWatchRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        android:clipToPadding="false"
        android:paddingTop="300dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="128dp"
        tools:listitem="@layout/item_episode_grid" />

    <androidx.cardview.widget.CardView
        android:id="@+id/tmdbWatchBackCard"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="end"
        android:layout_margin="16dp"
        android:focusable="true"
        android:nextFocusDown="@+id/tmdbWatchRecycler"
        android:translationZ="7dp"
        app:cardBackgroundColor="@color/nav_bg"
        app:cardCornerRadius="16dp">

        <ImageButton
            android:id="@+id/tmdbWatchBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_round_close_24"
            app:tint="?attr/colorOnBackground"
            tools:ignore="ContentDescription" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/tmdbWatchScrollTop"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:nextFocusDown="@id/tmdbWatchScrollTop"
        android:visibility="gone"
        app:cardBackgroundColor="#FF333333"
        app:cardCornerRadius="24dp"
        app:contentPadding="12dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:rotation="90"
            app:srcCompat="@drawable/ic_round_arrow_back_ios_new_24"
            app:tint="@android:color/white"
            tools:ignore="ContentDescription" />
    </androidx.cardview.widget.CardView>

    <!-- Comments coming-soon placeholder -->
    <FrameLayout
        android:id="@+id/tmdbWatchCommentsPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tmdbWatchCommentsComingSoon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:text="@string/coming_soon"
                android:textColor="@color/bg_white"
                android:textSize="22sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Vertical pill rail on the left (landscape / TV, same as anime mode) -->
    <FrameLayout
        android:id="@+id/tmdbWatchNavPills"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="8dp"
        android:elevation="10dp"
        android:translationZ="10dp"
        android:focusable="true"
        android:focusableInTouchMode="false"
        android:descendantFocusability="afterDescendants"
        android:clipToOutline="true">

        <ani.sanin.ui.components.SnakeNavRailView
            android:id="@+id/tmdbWatchNavPillBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:clickable="false"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:background="@drawable/bg_clay_pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/tmdbWatchNavPillInfo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="12dp"
                android:src="@drawable/ic_round_info_24"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:contentDescription="@string/info"
                android:focusable="true"
                android:nextFocusUp="@id/tmdbWatchNavPillComments"
                android:nextFocusDown="@id/tmdbWatchNavPillWatch" />

            <ImageButton
                android:id="@+id/tmdbWatchNavPillWatch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="12dp"
                android:src="@drawable/ic_round_movie_filter_24"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:contentDescription="@string/watch"
                android:focusable="true"
                android:nextFocusUp="@id/tmdbWatchNavPillInfo"
                android:nextFocusDown="@id/tmdbWatchNavPillComments" />

            <ImageButton
                android:id="@+id/tmdbWatchNavPillComments"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="12dp"
                android:src="@drawable/ic_round_comment_24"
                android:scaleType="fitCenter"
                android:background="@android:color/transparent"
                android:contentDescription="@string/comments"
                android:focusable="true"
                android:nextFocusUp="@id/tmdbWatchNavPillWatch"
                android:nextFocusDown="@id/tmdbWatchNavPillInfo" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
