<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    tools:context=".cloudstream.CloudStreamRepoDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/nav_bg_inv"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <ImageButton
                android:id="@+id/csRepoBack"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@color/nav_bg_inv"
                android:focusable="true"
                android:padding="16dp"
                app:srcCompat="@drawable/ic_round_arrow_back_ios_new_24"
                app:tint="?attr/colorOnBackground"
                tools:ignore="ContentDescription,SpeakableTextPresentCheck" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/csRepoTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:maxLines="2"
            android:textSize="20sp"
            android:textColor="?attr/colorOnSurface"
            tools:text="Zangetsu Providers" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/csRepoProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="48dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/csRepoRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="24dp"
        android:clipToPadding="false"
        android:focusable="true"
        android:paddingBottom="64dp" />

    <TextView
        android:id="@+id/csRepoEmptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/poppins_semi_bold"
        android:gravity="center"
        android:padding="32dp"
        android:textSize="15sp"
        android:textColor="?attr/colorOnSurface"
        android:visibility="gone"
        tools:text="No extensions" />
</LinearLayout>
