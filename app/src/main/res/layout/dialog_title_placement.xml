<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:paddingBottom="8dp"
            android:text="Title Placement"
            android:textColor="?attr/colorPrimary"
            android:textSize="20sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider" />

        <!-- ─── Placement options ─── -->
        <RadioGroup
            android:id="@+id/titlePlacementGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/titlePlacementOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:minHeight="44dp"
                android:text="Overlay Bottom (Landscape)"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/titlePlacementBelow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:minHeight="44dp"
                android:text="Below Card"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/titlePlacementHidden"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:minHeight="44dp"
                android:text="Hidden"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="?android:attr/listDivider" />

        <!-- ─── Gradient intensity slider ─── -->
        <include
            android:id="@+id/titleGradientSlider"
            layout="@layout/item_settings_section_slider" />
    </LinearLayout>
</ScrollView>
