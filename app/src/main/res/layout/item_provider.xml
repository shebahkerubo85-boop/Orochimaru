<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/providerCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:nextFocusRight="@+id/providerDragHandle"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/providerDragHandle"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="-10dp"
            android:layout_marginEnd="3dp"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusRight="@+id/providerActionIcon"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/providerDragUpArrow"
                android:layout_width="16dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_round_keyboard_arrow_up_24" />

            <ImageView
                android:id="@+id/providerDragDownArrow"
                android:layout_width="16dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_round_keyboard_arrow_down_24" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/providerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                tools:text="Reanime" />

            <TextView
                android:id="@+id/providerLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_language_badge"
                android:fontFamily="@font/poppins_bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="10sp"
                tools:text="English" />
        </LinearLayout>

        <ImageView
            android:id="@+id/providerActionIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:padding="8dp"
            android:src="@drawable/ic_download_24"
            app:tint="?attr/colorPrimary" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/providerProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="0"
        android:progressTint="?attr/colorPrimary"
        android:visibility="gone" />

</LinearLayout>
