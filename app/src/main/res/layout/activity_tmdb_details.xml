<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <ImageView
        android:id="@+id/tmdbDetailBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        tools:ignore="ContentDescription" />

    <View
        android:id="@+id/tmdbDetailGradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tmdb_detail_gradient" />

    <androidx.cardview.widget.CardView
        android:id="@+id/tmdbDetailBackCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:focusable="true"
        app:cardBackgroundColor="@color/nav_bg_inv"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <ImageButton
            android:id="@+id/tmdbDetailBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/nav_bg_inv"
            android:focusable="true"
            android:padding="14dp"
            app:srcCompat="@drawable/ic_round_arrow_back_ios_new_24"
            tools:ignore="ContentDescription" />
    </androidx.cardview.widget.CardView>

    <FrameLayout
        android:id="@+id/tmdbDetailFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
