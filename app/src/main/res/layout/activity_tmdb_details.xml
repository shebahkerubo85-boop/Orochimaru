<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/tmdbDetailHeader"
            android:layout_width="match_parent"
            android:layout_height="260dp">

            <ImageView
                android:id="@+id/tmdbDetailBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription" />

            <View
                android:id="@+id/tmdbDetailGradient"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/tmdb_detail_gradient" />

            <androidx.cardview.widget.CardView
                android:id="@+id/tmdbDetailBackCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:focusable="true"
                app:cardBackgroundColor="@color/nav_bg_inv"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <ImageButton
                    android:id="@+id/tmdbDetailBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@color/nav_bg_inv"
                    android:focusable="true"
                    android:padding="14dp"
                    app:srcCompat="@drawable/ic_round_arrow_back_ios_new_24"
                    app:tint="?attr/colorOnBackground"
                    tools:ignore="ContentDescription" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/tmdbDetailHeaderContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/tmdbDetailLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tmdbDetailRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semi_bold"
                        android:textColor="@color/bg_white"
                        android:textSize="14sp"
                        tools:text="★ 8.4  •  2024" />

                    <TextView
                        android:id="@+id/tmdbDetailStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/tmdb_chip_bg"
                        android:fontFamily="@font/poppins_semi_bold"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/bg_white"
                        android:textSize="12sp"
                        tools:text="Released" />

                    <!-- List Editor Button (matches anime mode style) -->
                    <Button
                        android:id="@+id/tmdbDetailListEditorCard"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="16dp"
                        android:ellipsize="marquee"
                        android:focusable="true"
                        android:fontFamily="@font/poppins_bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:text="Add to List" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/tmdbDetailBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Play button moved here: below banner, above synopsis, left aligned -->
            <androidx.cardview.widget.CardView
                android:id="@+id/tmdbDetailPlayCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_round_play_arrow_24"
                        app:tint="@color/bg_white" />

                    <TextView
                        android:id="@+id/tmdbDetailPlayText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="@color/bg_white"
                        android:textSize="15sp"
                        android:text="Play" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Synopsis title -->
            <TextView
                android:id="@+id/tmdbDetailSynopsisTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Synopsis"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tmdbDetailSynopsis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:lineSpacingMultiplier="1.15"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                tools:text="Paul Atreides unites with Chani and the Fremen while seeking revenge against the conspirators who destroyed his family." />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/tmdbDetailGenreChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="false" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/tmdbDetailSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
