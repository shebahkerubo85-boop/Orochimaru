<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/sheetMediaTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:padding="16dp"
        android:text="Media"
        android:textColor="?attr/colorPrimary"
        android:textSize="20sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <!-- Anime card button -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sheetAnimeButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent">

        <ImageView
            android:id="@+id/sheetAnimeBanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <View
            android:id="@+id/sheetAnimeScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:alpha="0.75"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/sheetAnimeProfilePic"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone"
                android:contentDescription="@string/empty" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_bold"
                android:text="Anime"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/sheetAnimeTrackerIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:contentDescription="@string/empty" />

            <ImageView
                android:id="@+id/sheetAnimeArrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_round_keyboard_arrow_down_24"
                android:contentDescription="@string/empty" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Anime expanded section -->
    <LinearLayout
        android:id="@+id/sheetAnimeExpanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="28dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Tracker"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/sheetAnimeAniList"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="16dp">

            <CheckBox
                android:id="@+id/sheetAnimeAniListCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="?attr/colorPrimary" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_anilist"
                android:contentDescription="@string/empty" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins"
                android:text="AniList"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sheetAnimeMAL"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="16dp">

            <CheckBox
                android:id="@+id/sheetAnimeMALCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="?attr/colorPrimary" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_myanimelist"
                android:contentDescription="@string/empty" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins"
                android:text="MyAnimeList"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Movie/TV card button -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sheetMovieButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent">

        <ImageView
            android:id="@+id/sheetMovieBanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <View
            android:id="@+id/sheetMovieScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/colorSurface"
            android:alpha="0.75"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/sheetMovieProfilePic"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone"
                android:contentDescription="@string/empty" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_bold"
                android:text="Movie / TV"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/sheetMovieTrackerIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:contentDescription="@string/empty" />

            <ImageView
                android:id="@+id/sheetMovieArrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_round_keyboard_arrow_down_24"
                android:contentDescription="@string/empty" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Movie/TV expanded section -->
    <LinearLayout
        android:id="@+id/sheetMovieExpanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="28dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Tracker"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/sheetMovieSimkl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="16dp">

            <CheckBox
                android:id="@+id/sheetMovieSimklCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="?attr/colorPrimary" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_simkl"
                android:contentDescription="@string/empty" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins"
                android:text="Simkl"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sheetMoviePluginRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="Plugin:"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/sheetMoviePluginSpinner"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:spinnerMode="dropdown" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
