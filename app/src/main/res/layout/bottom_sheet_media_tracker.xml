<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/sheetMediaTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:padding="16dp"
        android:text="Media"
        android:textColor="?attr/colorPrimary"
        android:textSize="20sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <!-- Anime button -->
    <LinearLayout
        android:id="@+id/sheetAnimeButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:text="Anime"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/sheetAnimeArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_round_keyboard_arrow_down_24"
            android:contentDescription="@string/empty" />
    </LinearLayout>

    <!-- Anime expanded section -->
    <LinearLayout
        android:id="@+id/sheetAnimeExpanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Tracker header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Tracker"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp" />

        <!-- AniList row -->
        <LinearLayout
            android:id="@+id/sheetAnimeAniList"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="32dp"
            android:paddingEnd="16dp">

            <CheckBox
                android:id="@+id/sheetAnimeAniListCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="?attr/colorPrimary" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_anilist"
                android:contentDescription="@string/empty" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins"
                android:text="AniList"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- MAL row -->
        <LinearLayout
            android:id="@+id/sheetAnimeMAL"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="32dp"
            android:paddingEnd="16dp">

            <CheckBox
                android:id="@+id/sheetAnimeMALCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="?attr/colorPrimary" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_myanimelist"
                android:contentDescription="@string/empty" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins"
                android:text="MyAnimeList"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Movie/TV button -->
    <LinearLayout
        android:id="@+id/sheetMovieButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:text="Movie / TV"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/sheetMovieArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_round_keyboard_arrow_down_24"
            android:contentDescription="@string/empty" />
    </LinearLayout>

    <!-- Movie/TV expanded section -->
    <LinearLayout
        android:id="@+id/sheetMovieExpanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Tracker header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Tracker"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp" />

        <!-- Simkl row -->
        <LinearLayout
            android:id="@+id/sheetMovieSimkl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="32dp"
            android:paddingEnd="16dp">

            <CheckBox
                android:id="@+id/sheetMovieSimklCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="?attr/colorPrimary"
                android:checked="true" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_simkl"
                android:contentDescription="@string/empty" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins"
                android:text="Simkl"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Plugin dropdown -->
        <LinearLayout
            android:id="@+id/sheetMoviePluginRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="32dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="Plugin:"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/sheetMoviePluginSpinner"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:entries="@array/plugin_names"
                android:spinnerMode="dropdown" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
