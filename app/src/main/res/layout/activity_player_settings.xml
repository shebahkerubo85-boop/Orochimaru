<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playerSettingsContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:descendantFocusability="afterDescendants"
    android:orientation="vertical"
    tools:context=".settings.PlayerSettingsActivity">

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/playerSettingsBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:padding="10dp"
            app:srcCompat="@drawable/ic_arrow_left"
            app:tint="?attr/colorOnSurface"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/player_settings"
                android:textColor="?attr/colorOnSurface"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:alpha="0.45"
                android:fontFamily="@font/poppins"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp"
                android:text="Player, subtitles &amp; behaviour" />
        </LinearLayout>

        <ImageView
            android:id="@+id/settingsLogo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_settings_logo_circle"
            android:padding="10dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_round_video_settings_24"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Scrollable Tab row -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        app:tabContentStart="16dp"
        app:tabGravity="fill"
        app:tabMode="scrollable"
        app:tabPaddingEnd="16dp"
        app:tabPaddingStart="16dp"
        app:tabTextAppearance="@style/NavBarText" />

    <!-- Content area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/tabScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:focusable="true"
        android:clipToPadding="false"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Subtitle preview container (shown only on subtitle tab) -->
            <FrameLayout
                android:id="@+id/subtitlePreviewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <!-- Dynamic tab content -->
            <LinearLayout
                android:id="@+id/tabContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
