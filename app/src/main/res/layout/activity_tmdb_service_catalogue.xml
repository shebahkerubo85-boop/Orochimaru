<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/listAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:id="@+id/settingsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/listTitle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center|start"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Widget.AppCompat.Toolbar.Title"
                android:textColor="?attr/colorOnBackground"
                android:textSize="16sp"
                tools:text="Netflix" />

            <ImageView
                android:id="@+id/mediaList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:alpha="0.33"
                android:padding="8dp"
                app:srcCompat="@drawable/ic_round_view_list_24"
                app:tint="?attr/colorOnBackground"
                tools:ignore="ContentDescription,ImageContrastCheck" />

            <ImageView
                android:id="@+id/mediaGrid"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:alpha="0.33"
                android:layout_marginEnd="24dp"
                android:padding="8dp"
                app:srcCompat="@drawable/ic_round_grid_view_24"
                app:tint="?attr/colorOnBackground"
                tools:ignore="ContentDescription,ImageContrastCheck" />
        </LinearLayout>

        <!--
          The movie/TV filter for this service's catalogue. A service carries both, so
          the grid defaults to Movie and the filter narrows it, matching the app's
          Movie / TV switch elsewhere.

          One pill with both entries rather than two chips: the pair is a single
          choice, not two independent filters, and two loose chips left the Material
          default chip fill showing as the theme's secondary container — a purple
          that belonged to no part of this app's palette.
        -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/catalogueTypeToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="8dp"
            app:selectionRequired="true"
            app:singleSelection="true"
            app:checkedButton="@id/catalogueToggleMovie">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/catalogueToggleMovie"
                style="@style/CatalogueToggleSegment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Movie" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/catalogueToggleTv"
                style="@style/CatalogueToggleSegment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TV show" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </com.google.android.material.appbar.AppBarLayout>

    <ani.sanin.FadingEdgeRecyclerView
        android:id="@+id/mediaRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:nestedScrollingEnabled="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:requiresFadingEdge="horizontal"
        tools:itemCount="4"
        tools:listitem="@layout/item_media_compact"
        tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
