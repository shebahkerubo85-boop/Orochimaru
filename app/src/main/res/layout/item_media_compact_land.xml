<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:padding="22dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/itemCompactCard"
            android:layout_width="260dp"
            android:layout_height="148dp"
            android:clipToOutline="true"
            android:translationZ="8dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/itemCompactImage"
                android:layout_width="260dp"
                android:layout_height="148dp"
                android:scaleType="centerCrop"
                android:transitionName="mediaCover"
                tools:ignore="ContentDescription,ImageContrastCheck"
                tools:srcCompat="@tools:sample/backgrounds/scenic" />

            <View
                android:id="@+id/itemCompactOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/itemCompactClearlogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:adjustViewBounds="true"
                android:maxWidth="140dp"
                android:maxHeight="48dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                tools:ignore="ContentDescription"
                tools:srcCompat="@tools:sample/backgrounds/scenic"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/itemCompactOverlayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:ellipsize="end"
                android:maxWidth="236dp"
                android:maxLines="3"
                android:textColor="#F3F3F3"
                android:textSize="13sp"
                android:visibility="gone"
                tools:ignore="SpUsage"
                tools:text="A very long title that will wrap to multiple lines inside the landscape card"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/itemCompactScoreBG"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="@drawable/bg_rating_pill"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/itemCompactBroadcast"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/ic_broadcast_ongoing"
                    android:visibility="gone"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/itemCompactScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:fontFamily="@font/poppins_bold"
                    android:paddingTop="2dp"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    tools:ignore="TextContrastCheck"
                    tools:text="0.0" />

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="10dp"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/ic_round_star_24"
                    app:tint="?attr/colorPrimary"
                    tools:ignore="ContentDescription" />

            </LinearLayout>

            <include
                layout="@layout/item_subdub_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp" />

        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <TextView
        android:id="@+id/itemCompactTitleBelow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-10dp"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_semi_bold"
        android:maxLines="2"
        android:paddingTop="2dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textAlignment="center"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp"
        android:visibility="gone"
        tools:ignore="SpUsage"
        tools:text="Title"
        tools:visibility="visible" />



    <include
        layout="@layout/item_progress_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp" />

</LinearLayout>
