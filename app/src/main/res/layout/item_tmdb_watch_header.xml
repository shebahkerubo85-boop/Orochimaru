<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="-24dp"
    android:layout_marginEnd="-24dp"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingTop="16dp">

    <!-- Shared clay-columns box: [left clay | middle | right clay] -->
    <LinearLayout
        android:id="@+id/tmdbWatchBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-16dp"
        android:background="?attr/colorSurface"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:padding="32dp">

        <!-- Left clay: refresh, settings, globe, subscribe -->
        <LinearLayout
            android:id="@+id/tmdbWatchClayLeft"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="-29dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_info_container"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/tmdbWatchRefresh"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:focusable="true"
                android:padding="3dp"
                app:srcCompat="@drawable/ic_round_refresh_24"
                app:tint="@android:color/white"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/tmdbWatchSettings"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:padding="3dp"
                app:srcCompat="@drawable/ic_round_settings_24"
                app:tint="@android:color/white"
                tools:ignore="ContentDescription,ImageContrastCheck" />

            <ImageView
                android:id="@+id/tmdbWatchGlobe"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:padding="3dp"
                app:srcCompat="@drawable/ic_baseline_public_24"
                app:tint="@android:color/white"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/tmdbWatchNotify"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:padding="3dp"
                app:srcCompat="@drawable/ic_round_notifications_none_24"
                app:tint="@android:color/white"
                tools:ignore="ContentDescription,ImageContrastCheck" />
        </LinearLayout>

        <!-- Middle column: auto-search (spinner + title) and source chips -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/tmdbWatchSpinner"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/colorSecondary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tmdbWatchSourceTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="marquee"
                    android:fontFamily="@font/poppins_bold"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="@string/tmdb_watch_auto_search" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/tmdbWatchSourceScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/tmdbWatchSourceChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true"
                    app:selectionRequired="false" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Right clay: layout, sort, download, faq -->
        <LinearLayout
            android:id="@+id/tmdbWatchClayRight"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="-29dp"
            android:background="@drawable/bg_info_container"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/tmdbWatchAppearance"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:focusable="true"
                android:padding="3dp"
                app:srcCompat="@drawable/ic_round_view_comfy_24"
                app:tint="@android:color/white"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/tmdbWatchSort"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:padding="3dp"
                app:srcCompat="@drawable/ic_round_unfold_more_24"
                app:tint="@android:color/white"
                tools:ignore="ContentDescription,ImageContrastCheck" />

            <ImageView
                android:id="@+id/tmdbWatchDownload"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:padding="3dp"
                app:srcCompat="@drawable/ic_download_24"
                app:tint="@android:color/white"
                tools:ignore="ContentDescription,ImageContrastCheck" />

            <ImageView
                android:id="@+id/tmdbWatchFaq"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:padding="3dp"
                app:srcCompat="@drawable/question_mark_24"
                app:tint="@android:color/white"
                tools:ignore="ContentDescription,ImageContrastCheck" />
        </LinearLayout>
    </LinearLayout>

    <!-- Season area (tv) -->
    <HorizontalScrollView
        android:id="@+id/tmdbWatchSeasonScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/tmdbWatchSeasonChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <!-- Single-season label -->
    <TextView
        android:id="@+id/tmdbWatchSingleSeason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins_semi_bold"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:visibility="gone"
        tools:text="1 Season"
        tools:visibility="visible" />

    <!-- Movie row: prequel / sequel -->
    <LinearLayout
        android:id="@+id/tmdbWatchMovieRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <Button
            android:id="@+id/tmdbWatchPrequel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/tmdb_watch_prequel"
            android:textAllCaps="false"
            android:textColor="?attr/colorPrimary" />

        <Button
            android:id="@+id/tmdbWatchSequel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/tmdb_watch_sequel"
            android:textAllCaps="false"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <!-- Continue watching -->
    <androidx.cardview.widget.CardView
        android:id="@+id/tmdbWatchContinueCard"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:focusable="true"
        android:translationZ="8dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        android:visibility="gone"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/tmdbWatchContinueImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription" />

            <View
                android:id="@+id/tmdbWatchContinueScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_bottom_top" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tmdbWatchContinueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_bold"
                    android:maxLines="1"
                    android:text="@string/tmdb_watch_continue"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tmdbWatchContinueDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.85"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:maxLines="1"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    tools:text="S1 E3 • 12:34" />
            </LinearLayout>

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_round_play_arrow_24"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:id="@+id/tmdbWatchContinueProgressCont"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="horizontal">

                <View
                    android:id="@+id/tmdbWatchContinueProgress"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="0"
                    android:background="?attr/colorPrimary" />

                <View
                    android:id="@+id/tmdbWatchContinueProgressEmpty"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="#66FFFFFF" />
            </LinearLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Episodes header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/episodes"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tmdbWatchEpisodeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:alpha="0.6"
            android:fontFamily="@font/poppins_semi_bold"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            tools:text="24 Episodes" />
    </LinearLayout>
</LinearLayout>