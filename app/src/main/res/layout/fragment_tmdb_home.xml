<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/tmdbBannerFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.cardview.widget.CardView
                android:id="@+id/tmdbBannerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToOutline="true"
                app:cardBackgroundColor="@android:color/black"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/tmdbBannerImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:ignore="ContentDescription" />

                <View
                    android:id="@+id/tmdbBannerCardScrim"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="left"
                    android:background="@drawable/banner_scrim_left"
                    android:importantForAccessibility="no"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/tmdbBannerCarousel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:visibility="gone"
                    tools:listitem="@layout/item_banner_card"
                    tools:orientation="horizontal" />
            </androidx.cardview.widget.CardView>

            <View
                android:id="@+id/tmdbBannerFade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_fade_black_left"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/tmdbBannerSide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/tmdbBannerLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="240dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tmdbBannerSideMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:textColor="@color/bg_white"
                    android:textSize="13sp"
                    tools:text="★ 8.4  •  2024  •  Movie" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/tmdbBannerSideChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:singleSelection="false" />

                <TextView
                    android:id="@+id/tmdbBannerSideSynopsis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:alpha="0.85"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins"
                    android:lineSpacingExtra="4sp"
                    android:maxLines="4"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Paul Atreides unites with Chani and the Fremen while seeking revenge against the conspirators who destroyed his family." />

                <TextView
                    android:id="@+id/tmdbBannerSideWatchBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/tag_chip_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="8dp"
                    android:text="@string/watch_now"
                    android:textColor="@color/bg_white"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tmdbBannerContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/tmdb_detail_gradient"
                android:gravity="bottom"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/tmdbBannerPortraitLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="160dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tmdbBannerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:maxLines="2"
                    android:textColor="@color/bg_white"
                    android:textSize="26sp"
                    tools:text="Dune: Part Two" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tmdbBannerStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ic_banner_background"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:text="Released" />

                    <View
                        android:id="@+id/tmdbBannerStatusDivider"
                        android:layout_width="1dp"
                        android:layout_height="12dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="#88FFFFFF"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tmdbBannerRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semi_bold"
                        android:textColor="#FFDD44"
                        android:textSize="13sp"
                        tools:text="★ 8.4  •  2024  •  Movie" />

                    <View
                        android:id="@+id/tmdbBannerMetaDivider"
                        android:layout_width="1dp"
                        android:layout_height="12dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="#88FFFFFF" />

                    <TextView
                        android:id="@+id/tmdbBannerGenres"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_semi_bold"
                        android:maxLines="1"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp"
                        tools:text="Science Fiction • Adventure • Action" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tmdbBannerSynopsis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0.85"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins"
                    android:lineSpacingExtra="3sp"
                    android:maxLines="3"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    tools:text="Paul Atreides unites with Chani and the Fremen while seeking revenge against the conspirators who destroyed his family." />

                <TextView
                    android:id="@+id/tmdbBannerWatchBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/tag_chip_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="8dp"
                    android:text="@string/watch_now"
                    android:textColor="@color/bg_white"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>


        <LinearLayout
            android:id="@+id/tmdbBannerDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/tmdbHomeSpinner"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp"
            android:indeterminateTint="?attr/colorPrimary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/tmdbHomeSections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
