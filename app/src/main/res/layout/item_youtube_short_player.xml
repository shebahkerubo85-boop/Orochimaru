<?xml version="1.0" encoding="utf-8"?>
<!--
    One full-screen reel. Kept deliberately bare: the WebView is the only real content, and a
    transparent blocker sits on top so none of YouTube's own chrome (tap-to-pause, title links,
    "watch on YouTube") ever receives touch. Playback control lives in the activity overlay, and
    paging keeps working because the RecyclerView intercepts drags above the blocker.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <WebView
        android:id="@+id/youtubeWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/touchBlocker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        android:contentDescription="@null" />

</FrameLayout>
