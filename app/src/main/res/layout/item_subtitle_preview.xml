<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/subtitleTest"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/subtitlePreviewHeader"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_settings_card"
        android:focusable="true"
        android:fontFamily="@font/poppins"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="Preview"
        android:textColor="?attr/colorSecondary"
        android:textSize="12sp"
        android:alpha="0.6" />

    <LinearLayout
        android:id="@+id/subtitleTestWindow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="16dp">

        <TextView
            android:id="@+id/subtitleTestText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="@string/sub_text_example"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
