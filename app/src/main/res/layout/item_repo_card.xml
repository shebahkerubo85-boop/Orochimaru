<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/repoCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- GitHub glyph watermark (bottom-right) -->
    <ImageView
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.08"
        android:contentDescription="@null"
        app:srcCompat="@drawable/ic_github"
        app:tint="@android:color/white" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="2dp">

        <!-- Header row: logo + name + count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/repoLogo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CircularImageView"
                tools:src="@drawable/ic_extension" />

            <TextView
                android:id="@+id/repoName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                tools:text="CnC Verse" />

            <!-- Plugin count badge -->
            <TextView
                android:id="@+id/repoCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_count_badge"
                android:fontFamily="@font/poppins_bold"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                tools:text="12 plugins" />
        </LinearLayout>

        <!-- Content types row -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/repoContentTypes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:chipSpacingHorizontal="6dp"
            app:singleLine="true" />

        <!-- Language chips row -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/repoLanguages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:chipSpacingHorizontal="6dp"
            app:singleLine="true" />

    </LinearLayout>

    <!-- Browse pill button (bottom overlay) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/repoBrowseButton"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="2dp"
        android:backgroundTint="@android:color/white"
        android:focusable="true"
        android:fontFamily="@font/poppins_bold"
        android:text="Browse"
        android:textAllCaps="false"
        android:textColor="#FF1A1A1A"
        android:textSize="13sp"
        app:cornerRadius="24dp" />

</FrameLayout>
