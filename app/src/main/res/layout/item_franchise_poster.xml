<?xml version="1.0" encoding="utf-8"?>
<!--
  One entry in a franchise poster row: the poster, with its release year directly
  beneath it. Width and height are set in code from the measured row width so the
  count of cells that fit depends on the screen, not on a fixed column number.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToOutline="true"
        android:translationZ="4dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <ImageView
            android:id="@+id/posterImage"
            android:layout_width="match_parent"
            android:layout_height="114dp"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription,ImageContrastCheck"
            tools:srcCompat="@tools:sample/backgrounds/scenic" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/posterYear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_semi_bold"
        android:gravity="center"
        android:maxLines="1"
        android:paddingTop="3dp"
        android:singleLine="true"
        android:textColor="#F3F3F3"
        android:textSize="11sp"
        tools:ignore="SpUsage,TextContrastCheck"
        tools:text="2002" />

</LinearLayout>
