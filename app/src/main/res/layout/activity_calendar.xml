<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calendarRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:descendantFocusability="afterDescendants"
    android:fillViewport="true"
    tools:context=".media.CalendarActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/calendarHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/calendarBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:padding="10dp"
                app:srcCompat="@drawable/ic_arrow_left"
                app:tint="?attr/colorOnSurface"
                tools:ignore="ContentDescription" />

            <!-- Go to today -->
            <ImageButton
                android:id="@+id/calendarTodayBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:padding="10dp"
                app:srcCompat="@drawable/ic_round_calendar_today_24"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="Go to today" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="6dp">

                <TextView
                    android:id="@+id/calendarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/release_calendar"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/calendarSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:alpha="0.45"
                    android:fontFamily="@font/poppins"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11sp"
                    android:text="Episodes this week" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/calendarSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_settings_logo_circle"
                android:focusable="true"
                android:padding="10dp"
                app:srcCompat="@drawable/ic_baseline_tune_24"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="Calendar settings" />
        </LinearLayout>

        <!-- Week Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/calendarPrevWeek"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:padding="6dp"
                app:srcCompat="@drawable/ic_arrow_left"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="Previous week" />

            <TextView
                android:id="@+id/calendarWeekLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:fontFamily="@font/poppins_semi_bold"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                tools:text="Sep 1 - Sep 7" />

            <ImageButton
                android:id="@+id/calendarNextWeek"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:padding="6dp"
                app:srcCompat="@drawable/ic_arrow_right"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="Next week" />
        </LinearLayout>

        <!-- Week Day Strip -->
        <LinearLayout
            android:id="@+id/calendarWeekStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="12dp"
            android:orientation="horizontal" />

        <!-- Day Label -->
        <TextView
            android:id="@+id/calendarDayLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="16dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="Monday, September 1" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/calendarEmpty"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:alpha="0.3"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_round_calendar_today_24"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alpha="0.5"
                android:fontFamily="@font/poppins"
                android:text="No episodes this day"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Episode list for selected day -->
        <LinearLayout
            android:id="@+id/calendarDayEpisodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:visibility="gone" />

        <!-- Upcoming shelf -->
        <LinearLayout
            android:id="@+id/calendarUpcomingSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/poppins_semi_bold"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:text="Upcoming Episodes" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/calendarUpcomingRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- Missing shelf -->
        <LinearLayout
            android:id="@+id/calendarMissingSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/poppins_semi_bold"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:text="Missing Episodes" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/calendarMissingRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
