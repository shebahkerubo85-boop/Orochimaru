<?xml version="1.0" encoding="utf-8"?>
<!--
  The franchise screen, reached by pressing a franchise card on either Explore page.

  Structure, top to bottom: the filter pill row, the franchise's own logo art and name, then the
  alternating card/synopsis rows. The rows are children of a LinearLayout rather than a
  RecyclerView, because the whole point is the flowing connector between them — a recycling
  container would drop and rebuild the rows the line is drawn between, and the line would flicker
  as they were reused.

  Every franchise is a few dozen entries at most, so building them all is bounded and the
  connector can be drawn once in a single pass over the laid-out row positions.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/franchiseRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/franchise_page">

    <LinearLayout
        android:id="@+id/franchiseHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <!-- Back and the filter pills on one line. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="24dp">

            <ImageView
                android:id="@+id/franchiseBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@android:string/cancel"
                android:focusable="true"
                android:padding="8dp"
                android:rotation="90"
                app:srcCompat="@drawable/ic_expand_more"
                app:tint="@color/franchise_on_page" />

            <HorizontalScrollView
                android:id="@+id/franchiseFilterScroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_franchise_filter_pill"
                android:padding="3dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/franchiseFilterRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

        </LinearLayout>

        <!-- Logo art and the franchise name, centred, per spec. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:id="@+id/franchiseLogo"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:maxHeight="56dp"
                android:visibility="gone"
                tools:srcCompat="@tools:sample/backgrounds/scenic"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/franchiseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center_horizontal"
                android:textColor="@color/franchise_on_page"
                android:textSize="22sp"
                tools:ignore="SpUsage"
                tools:text="Naruto" />

            <TextView
                android:id="@+id/franchiseEntryCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:fontFamily="@font/poppins"
                android:gravity="center_horizontal"
                android:textColor="@color/franchise_on_page_muted"
                android:textSize="11sp"
                tools:text="8 entries" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ProgressBar
                android:id="@+id/franchiseProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/franchiseEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alpha="0.7"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:text="@string/franchise_no_entries"
                android:textColor="@color/franchise_on_page_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <!--
              The whole flow scrolls. The rows are added here by the activity.

              This used to be a FrameLayout wrapping a connector view that drew a line from each
              card to the next. The line is gone: it was the one primary-coloured thing on a screen
              whose whole surface is otherwise flat page colour, and it read as a chart rather than
              as a list. Alternation now carries the order on its own.
            -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/franchiseScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/franchiseRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="24dp" />

            </androidx.core.widget.NestedScrollView>

        </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
