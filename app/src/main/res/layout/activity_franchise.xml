<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/franchiseRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/franchise_page">

    <LinearLayout
        android:id="@+id/franchiseHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="24dp">

            <ImageView
                android:id="@+id/franchiseBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@android:string/cancel"
                android:focusable="true"
                android:nextFocusRight="@id/franchiseFilterPill"
                android:padding="8dp"
                android:rotation="90"
                app:srcCompat="@drawable/ic_expand_more"
                app:tint="@color/franchise_on_page" />

            <ani.sanin.ui.components.LibraryStatusPill
                android:id="@+id/franchiseFilterPill"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:focusable="true"
                android:nextFocusLeft="@id/franchiseBack" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:id="@+id/franchiseLogo"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:maxHeight="56dp"
                android:visibility="gone"
                tools:srcCompat="@tools:sample/backgrounds/scenic"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/franchiseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center_horizontal"
                android:textColor="@color/franchise_on_page"
                android:textSize="22sp"
                tools:ignore="SpUsage"
                tools:text="Naruto" />

            <TextView
                android:id="@+id/franchiseEntryCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:fontFamily="@font/poppins"
                android:gravity="center_horizontal"
                android:textColor="@color/franchise_on_page_muted"
                android:textSize="11sp"
                tools:text="8 entries" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ProgressBar
                android:id="@+id/franchiseProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/franchiseEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alpha="0.7"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:text="@string/franchise_no_entries"
                android:textColor="@color/franchise_on_page_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/franchiseScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/franchiseRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="24dp" />

            </androidx.core.widget.NestedScrollView>

        </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
