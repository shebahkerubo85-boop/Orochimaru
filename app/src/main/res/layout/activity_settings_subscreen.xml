<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared subscreen template: header + scrollable card sections.
  Each subscreen sets its own title, icon, and content.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/subscreenScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:descendantFocusability="afterDescendants"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/subscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/subscreenBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:focusable="true"
                android:padding="10dp"
                app:srcCompat="@drawable/ic_arrow_left"
                app:tint="?attr/colorOnSurface"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="6dp">

                <TextView
                    android:id="@+id/subscreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="24sp"
                    tools:text="Settings" />

                <TextView
                    android:id="@+id/subscreenSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:alpha="0.45"
                    android:fontFamily="@font/poppins"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Manage your preferences" />
            </LinearLayout>

            <ImageView
                android:id="@+id/subscreenIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_settings_logo_circle"
                android:padding="10dp"
                android:importantForAccessibility="no"
                app:tint="?attr/colorOnSurface"
                tools:src="@drawable/ic_settings_display"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <!-- Content area: sections go here -->
        <LinearLayout
            android:id="@+id/subscreenContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
