<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/episodeItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- ── TOP NOTIFICATION PILL ─────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/episodePill"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_clay_pill"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/episodePillPoster"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_round_person_24"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CircularImageView"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/episodePillText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semi_bold"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp"
                tools:text="Episode 1 of One Piece has aired" />

            <TextView
                android:id="@+id/episodePillTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:alpha="0.66"
                android:fontFamily="@font/poppins"
                android:textColor="?attr/colorOnSurface"
                android:textSize="10sp"
                tools:text="2 minutes ago" />
        </LinearLayout>
    </FrameLayout>

    <!-- Exact 2dp gap between pill and card -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="2dp" />

    <!-- ── EPISODE CARD ──────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/episodeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="84dp"
        android:background="@drawable/bg_episode_card"
        android:clipToOutline="true">

        <!-- Top rim (dark in dark mode, light in light mode — set in code) -->
        <View
            android:id="@+id/episodeRim"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_gravity="top"
            android:clickable="false"
            android:focusable="false" />

        <ImageView
            android:id="@+id/episodeThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@android:color/black"
            tools:ignore="ContentDescription" />

        <View
            android:id="@+id/episodeGradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Left zone keeps the thumbnail visible (gradient territory) -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.3" />

            <LinearLayout
                android:id="@+id/episodeInfo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.7"
                android:gravity="top"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <!-- Pure episode title: up to 3 lines, wraps, then ellipsizes -->
                <TextView
                    android:id="@+id/episodeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_bold"
                    android:maxLines="3"
                    android:textSize="15sp"
                    tools:text="I'm Luffy! The Man Who's Gonna Be King of the Pirates!" />

                <LinearLayout
                    android:id="@+id/episodeMetaRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/episodeMetaDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_baseline_clock_24"
                            android:drawablePadding="4dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppins_semi_bold"
                            android:maxLines="1"
                            android:textSize="11sp"
                            tools:text="24m" />

                        <TextView
                            android:id="@+id/episodeMetaDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:drawableStart="@drawable/ic_round_calendar_today_24"
                            android:drawablePadding="4dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppins_semi_bold"
                            android:maxLines="1"
                            android:textSize="11sp"
                            tools:text="2025-09-07  10:24 PM" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/episodeWatch"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="10dp"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:fontFamily="@font/poppins_bold"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="14dp"
                        android:text="Watch"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:cornerRadius="17dp"
                        app:icon="@drawable/ic_baseline_play_arrow_24"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="15dp"
                        android:insetBottom="0dp"
                        android:insetTop="0dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
