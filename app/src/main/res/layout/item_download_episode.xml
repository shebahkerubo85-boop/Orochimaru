<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="18dp"
    android:layout_marginEnd="18dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_download_card"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/episodeThumb"
            android:layout_width="104dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_download_thumb"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_download_24"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/episodeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semi_bold"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13.5sp"
                tools:text="74 · The Next Hokage" />

            <TextView
                android:id="@+id/episodeMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.45"
                android:ellipsize="end"
                android:fontFamily="@font/poppins"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp"
                tools:text="reanime HD · 720p" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/episodeSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:alpha="0.7"
                    android:fontFamily="@font/poppins"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11.5sp"
                    tools:text="20 MB / 70 MB" />

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/episodeRing"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        app:indicatorColor="?attr/colorPrimary"
                        app:indicatorSize="48dp"
                        app:trackColor="?attr/colorOutline"
                        app:trackThickness="4dp" />

                    <TextView
                        android:id="@+id/episodePercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/poppins_semi_bold"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="10.5sp"
                        tools:text="80%" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/episodeSpeed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:alpha="0.45"
            android:fontFamily="@font/poppins"
            android:textColor="?attr/colorOnSurface"
            android:textSize="10.5sp"
            tools:text="3.2 MB/s" />

        <ImageButton
            android:id="@+id/episodeAction"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="3dp"
            android:tint="?attr/colorOnSurface"
            app:srcCompat="@drawable/ic_baseline_pause_24"
            tools:ignore="ContentDescription" />

        <ImageButton
            android:id="@+id/episodeDelete"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="3dp"
            android:tint="?attr/colorError"
            app:srcCompat="@drawable/ic_baseline_close_24"
            tools:ignore="ContentDescription" />
    </LinearLayout>
</LinearLayout>