<?xml version="1.0" encoding="utf-8"?>
<!--
  A franchise card. The banner is the card's *background*: a fixed 152dp band, with the
  poster row and the title sitting on top of it, near its bottom edge. The content is not
  stacked below the artwork, so the card never grows past the band however many entries the
  row holds. The row is not scrollable, it holds however many entries fit the screen width;
  the rest belong on the dedicated franchise screen.

  ## Why the content is bottom-aligned inside the band

  The poster row and the title float over the artwork, which is why the band needs a dim
  behind them: bg_franchise_banner_dim is the wash that keeps the year and the title legible
  over whatever frame happens to be behind them. They are pinned to the band's bottom edge
  so that edge is a fixed reference the title's bottom padding can be measured against, and
  so the artwork left showing above the posters is always the same generous band of image
  rather than a sliver that changes with the entry count.

  The band is wrap_content with the artwork pinned to its top, not a fixed height. The
  content is pinned to the bottom, so if a large font scale or a long title needs more room
  than 152dp the band grows to fit instead of clipping the title off the end.

  ## Spacing, top to bottom, and why it is trustworthy

  poster, 1dp, year, 2dp, title, 2dp, bottom edge.

  The two text runs carry includeFontPadding="false". Without it Android reserves the font's
  own ascent and descent on top of any declared padding, which is worth several dp at each
  end — enough to bury a 1dp or 2dp value entirely, and the reason tuning those numbers used
  to appear to do nothing. With it off, the padding written here is the gap on screen.

  The 16dp margin is what separates two cards. It is the card's only outer breathing room,
  so it carries the whole row's rhythm; stacked, two cards are 32dp apart.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/franchiseContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:focusable="true"
    android:focusableInTouchMode="false"
    app:cardBackgroundColor="@color/nav_bg"
    app:cardCornerRadius="28dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="152dp">

        <!--
          The artwork band. Both layers fill it rather than restating its height, so the dim
          cannot drift out of step with the image it is washing.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/franchiseBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription"
                tools:srcCompat="@tools:sample/backgrounds/scenic" />

            <ImageView
                android:id="@+id/franchiseDim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/bg_franchise_banner_dim"
                tools:ignore="ContentDescription" />

        </FrameLayout>

        <!--
          The content strip, filling the band: poster row, then the year under each poster,
          then the franchise name.

          The poster row is weighted rather than sized, so it absorbs whatever height is left
          once the gaps and the two text runs have taken theirs. That is what makes the 1dp at
          the top real: the poster cannot be a fixed height and still leave 1dp above it,
          because the band is a fixed height and only two things can share it out. The poster
          is therefore around 110dp on a 152dp band, which is the poster filling its share
          rather than sitting small under a wide gap.

          Only the gaps are declared. Nothing here states the poster's height, so there is no
          second number that can disagree with the band's.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="1dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:id="@+id/posterRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/franchiseTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingBottom="1dp"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:transitionName="mediaTitle"
                tools:ignore="SpUsage"
                tools:text="Naruto" />

        </LinearLayout>

    </FrameLayout>

</androidx.cardview.widget.CardView>
