<?xml version="1.0" encoding="utf-8"?>
<!--
  A franchise card. The banner is the card's background and stays a fixed 152dp however
  many entries the row below it holds: the *card* grows, the artwork band does not. The
  row is not scrollable, it holds however many entries fit the screen width; the rest
  belong on the dedicated franchise screen.

  Order top to bottom: banner, 2dp, poster row with a year 1dp under each poster, then
  2dp, the franchise's own name, then 1dp to the bottom. Those three gaps are the card's
  spec, measured up from the poster: 1dp, 2dp, 1dp. Only the banner is focusable, since
  it is what opens the franchise screen.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/franchiseContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:focusable="true"
    android:focusableInTouchMode="false"
    app:cardBackgroundColor="@color/nav_bg"
    app:cardCornerRadius="28dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/franchiseBanner"
            android:layout_width="match_parent"
            android:layout_height="152dp"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription"
            tools:srcCompat="@tools:sample/backgrounds/scenic" />

        <ImageView
            android:id="@+id/franchiseDim"
            android:layout_width="match_parent"
            android:layout_height="152dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/bg_franchise_banner_dim"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="2dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:id="@+id/posterRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/franchiseTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold"
                android:maxLines="1"
                android:paddingBottom="1dp"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:transitionName="mediaTitle"
                tools:ignore="SpUsage"
                tools:text="Naruto" />

        </LinearLayout>

    </FrameLayout>

</androidx.cardview.widget.CardView>
