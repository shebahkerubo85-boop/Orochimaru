<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/franchiseContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:focusable="true"
    android:focusableInTouchMode="false"
    app:cardBackgroundColor="@color/nav_bg"
    app:cardCornerRadius="28dp">

    <FrameLayout
        android:id="@+id/franchiseBand"
        android:layout_width="match_parent"
        android:layout_height="152dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/franchiseBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription"
                tools:srcCompat="@tools:sample/backgrounds/scenic" />

            <ImageView
                android:id="@+id/franchiseDim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/bg_franchise_banner_dim"
                tools:ignore="ContentDescription" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="1dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:id="@+id/posterRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/franchiseTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingBottom="1dp"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:transitionName="mediaTitle"
                tools:ignore="SpUsage"
                tools:text="Naruto" />

        </LinearLayout>

    </FrameLayout>

</androidx.cardview.widget.CardView>
