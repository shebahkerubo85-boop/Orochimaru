<?xml version="1.0" encoding="utf-8"?>
<!--
  A franchise card. The banner is the card's background and is a fixed 180dp: when a
  franchise has many entries the row below it grows and the banner does not. Taller than
  the banner it replaced (152dp) at the user's request, so more of the artwork shows and
  the wash over it carries more of the load. The row is not scrollable, it holds however
  many entries fit the screen width; the rest belong on the dedicated franchise screen.

  Order top to bottom: banner, 2dp, poster row with a year under each, then the
  franchise's own name. Only the banner is focusable, since it is what opens that screen.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/franchiseContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:focusable="true"
    android:focusableInTouchMode="false"
    app:cardBackgroundColor="@color/nav_bg"
    app:cardCornerRadius="28dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/franchiseBanner"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription"
            tools:srcCompat="@tools:sample/backgrounds/scenic" />

        <ImageView
            android:id="@+id/franchiseDim"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/bg_franchise_banner_dim"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="2dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:id="@+id/posterRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/franchiseTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold"
                android:maxLines="1"
                android:paddingBottom="10dp"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:transitionName="mediaTitle"
                tools:ignore="SpUsage"
                tools:text="Naruto" />

        </LinearLayout>

    </FrameLayout>

</androidx.cardview.widget.CardView>
