<?xml version="1.0" encoding="utf-8"?>
<!--
  A franchise card. The banner is the card's artwork band and stays a fixed 152dp however
  many entries the row below it holds: the *card* grows, the artwork band does not. The
  row is not scrollable, it holds however many entries fit the screen width; the rest
  belong on the dedicated franchise screen.

  ## The band and the content are stacked, not overlapped

  The banner and the content used to be siblings inside one FrameLayout, which put them at
  the same y: the posters and the title drew *over* the banner instead of under it, and the
  declared gaps below measured nothing anyone could see. The card now stacks them in a
  vertical LinearLayout, so each gap is a real gap between two things that are actually
  adjacent.

  ## Spacing, top to bottom, and why it is now trustworthy

  banner, 2dp, poster row, 1dp, year, 2dp, title, 2dp, bottom edge.

  The two text runs carry includeFontPadding="false". Without it Android reserves the font's
  own ascent and descent on top of any declared padding, which was worth several dp at each
  end — enough to bury a 1dp or 2dp value entirely, and the reason tuning those numbers used
  to appear to do nothing. With it off, the padding written here is the gap on screen.

  The 16dp margin is what separates two cards. It is the card's only outer breathing room,
  so it carries the whole row's rhythm; stacked, two cards are 32dp apart.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/franchiseContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:focusable="true"
    android:focusableInTouchMode="false"
    app:cardBackgroundColor="@color/nav_bg"
    app:cardCornerRadius="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!--
          The artwork band. Both layers fill the band rather than restating its height, so
          the dim cannot drift out of step with the image it is washing.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="152dp">

            <ImageView
                android:id="@+id/franchiseBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription"
                tools:srcCompat="@tools:sample/backgrounds/scenic" />

            <ImageView
                android:id="@+id/franchiseDim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/bg_franchise_banner_dim"
                tools:ignore="ContentDescription" />

        </FrameLayout>

        <!--
          The content strip: poster row, then the year, then the franchise name. Every gap in
          here is declared once and is the only thing producing the space it names.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="2dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:id="@+id/posterRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/franchiseTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:transitionName="mediaTitle"
                tools:ignore="SpUsage"
                tools:text="Naruto" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
