<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of the franchise screen: a landscape card and its teaser, alternating sides.

  The connector between rows is drawn by the activity into a canvas layered behind these, so
  this layout deliberately does not reserve space for it. The card is the focus target and the
  tap surface; the synopsis is not focusable, because the info affordance on the card is what
  opens the full text.

  Height is wrap: the card sets the row's height, and the synopsis is capped to match it by the
  activity rather than by a maxLines here, since maxLines cannot express "stop at the card's
  bottom edge" and would let a long teaser stretch the row and break the alternating rhythm.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/franchiseRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:layout_marginBottom="12dp"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- Card side. Width is 58% so the synopsis always gets a usable column beside it. -->
    <FrameLayout
        android:id="@+id/franchiseRowCardHolder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="3dp"
        android:layout_weight="58">

        <androidx.cardview.widget.CardView
            android:id="@+id/franchiseRowCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="false"
            app:cardBackgroundColor="#1A000000"
            app:cardCornerRadius="20dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/franchiseRowBackdrop"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    tools:ignore="ContentDescription"
                    tools:srcCompat="@tools:sample/backgrounds/scenic" />

                <!--
                  The gradient the information strip sits on. Without it the strip's text would
                  land on whatever the backdrop happens to be at that point, which is
                  unreadable over a bright frame.
                -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_franchise_card_gradient"
                    android:importantForAccessibility="no" />

                <!-- Type badge, top-start. Present only when the entry has a category. -->
                <TextView
                    android:id="@+id/franchiseRowType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_franchise_pill"
                    android:fontFamily="@font/poppins_bold"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="9sp"
                    android:visibility="gone"
                    tools:text="SERIES"
                    tools:visibility="visible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp">

                    <!-- Air date, runtime, rating, type. Omitted individually when unknown. -->
                    <LinearLayout
                        android:id="@+id/franchiseRowMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/franchiseRowAirDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.9"
                            android:fontFamily="@font/poppins_bold"
                            android:maxLines="1"
                            android:textColor="@android:color/white"
                            android:textSize="10sp"
                            tools:text="3 Oct 2002" />

                        <TextView
                            android:id="@+id/franchiseRowDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:alpha="0.9"
                            android:fontFamily="@font/poppins_bold"
                            android:maxLines="1"
                            android:textColor="@android:color/white"
                            android:textSize="10sp"
                            tools:text="23 min" />

                        <TextView
                            android:id="@+id/franchiseRowScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:alpha="0.9"
                            android:fontFamily="@font/poppins_bold"
                            android:maxLines="1"
                            android:textColor="@android:color/white"
                            android:textSize="10sp"
                            tools:text="★ 84" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/franchiseRowTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_bold"
                        android:maxLines="2"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        tools:ignore="SpUsage"
                        tools:text="Naruto" />

                    <!--
                      List status and the info affordance, end-aligned.

                      The status chip is the same shape as the one in the info tab so the two
                      read as the same control; tapping it opens the list editor.
                    -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/franchiseRowListStatus"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppins_bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:maxLines="1"
                            android:minWidth="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="@string/add_list"
                            android:textAllCaps="true"
                            android:textColor="@android:color/white"
                            android:textSize="10sp"
                            app:cornerRadius="15dp"
                            app:strokeColor="@android:color/white" />

                        <!-- Stylised i in a circle, as specced. -->
                        <FrameLayout
                            android:id="@+id/franchiseRowInfo"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_franchise_info_circle"
                            android:focusable="true"
                            android:focusableInTouchMode="false">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="@font/poppins_bold"
                                android:includeFontPadding="false"
                                android:text="i"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                tools:ignore="SpUsage" />

                        </FrameLayout>

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <!-- Synopsis side. The scrim is what the connector is drawn behind, per spec. -->
    <LinearLayout
        android:id="@+id/franchiseRowSynopsisHolder"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="3dp"
        android:layout_weight="42"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/franchiseRowSynopsisScrim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_franchise_synopsis_scrim"
            android:padding="6dp">

            <TextView
                android:id="@+id/franchiseRowSynopsis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.85"
                android:ellipsize="end"
                android:fontFamily="@font/poppins"
                android:lineSpacingExtra="2dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp"
                tools:text="Naruto tells the story of Naruto Uzumaki, a hyperactive ninja…" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>