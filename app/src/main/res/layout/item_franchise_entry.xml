<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/franchiseRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/franchise_row_margin"
    android:layout_marginEnd="@dimen/franchise_row_margin"
    android:layout_marginBottom="@dimen/franchise_row_bottom_margin"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/franchiseRowCardHolder"
        android:layout_width="@dimen/franchise_poster_width"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/franchise_row_gap">

        <androidx.cardview.widget.CardView
            android:id="@+id/franchiseRowCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false"
            app:cardBackgroundColor="#1A000000"
            app:cardCornerRadius="@dimen/franchise_card_corner"
            app:cardElevation="0dp"
            app:layout_constraintDimensionRatio="H,2:3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/franchiseRowBackdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    tools:ignore="ContentDescription"
                    tools:srcCompat="@tools:sample/backgrounds/scenic" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/franchise_poster_gradient_height"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_franchise_poster_gradient"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/franchiseRowScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="@dimen/franchise_rating_margin"
                    android:background="@drawable/bg_franchise_rating_pill"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:paddingStart="7dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/franchise_on_art"
                    android:textSize="@dimen/franchise_meta_size"
                    android:visibility="gone"
                    tools:text="★ 84"
                    tools:visibility="visible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp">

                    <FrameLayout
                        android:id="@+id/franchiseRowInfo"
                        android:layout_width="@dimen/franchise_info_size"
                        android:layout_height="@dimen/franchise_info_size"
                        android:background="@drawable/bg_franchise_info_circle"
                        android:focusable="true"
                        android:focusableInTouchMode="false">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/poppins_bold"
                            android:includeFontPadding="false"
                            android:text="i"
                            android:textColor="@color/franchise_on_art"
                            android:textSize="14sp"
                            tools:ignore="SpUsage" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/franchiseRowYear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center_horizontal"
                        android:includeFontPadding="false"
                        android:shadowColor="#B3000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        android:textColor="@color/franchise_on_art"
                        android:textSize="@dimen/franchise_year_size"
                        tools:text="2002" />

                </LinearLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/franchiseRowListStatus"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/franchise_list_status_height"
            android:layout_marginTop="@dimen/franchise_list_status_top"
            android:ellipsize="end"
            android:focusable="false"
            android:fontFamily="@font/poppins_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/add_list"
            android:textAllCaps="true"
            android:textColor="@color/franchise_list_text"
            android:textSize="@dimen/franchise_meta_size"
            app:cornerRadius="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/franchiseRowCard"
            app:strokeColor="@color/franchise_list_stroke" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/franchiseRowSynopsisHolder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/franchiseRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_bold"
            android:maxLines="2"
            android:textColor="@color/franchise_on_page"
            android:textSize="@dimen/franchise_title_size"
            tools:ignore="SpUsage"
            tools:text="Naruto Shippuden" />

        <TextView
            android:id="@+id/franchiseRowSynopsis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/franchise_synopsis_gap"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/franchise_on_page"
            android:textSize="@dimen/franchise_synopsis_size"
            tools:text="Naruto tells the story of Naruto Uzumaki, a hyperactive ninja…" />

    </LinearLayout>

</LinearLayout>