<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true">

    <ImageView
        android:id="@+id/bannerBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.85"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        tools:src="@tools:sample/backgrounds/scenic" />

    <ImageView
        android:id="@+id/bannerImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        tools:src="@tools:sample/backgrounds/scenic" />

    <View
        android:id="@+id/bannerScrimLeft"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="left"
        android:background="@drawable/banner_scrim_left"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <View
        android:id="@+id/bannerBottomGradient"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="bottom"
        android:background="@drawable/linear_gradient_bg"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/bannerContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/bannerClearlogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:maxWidth="160dp"
            android:maxHeight="40dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:src="@tools:sample/backgrounds/scenic"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/bannerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_bold"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="@color/bg_white"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Attack on Titan" />

        <TextView
            android:id="@+id/bannerDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.85"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:lineSpacingExtra="4sp"
            android:maxLines="4"
            android:shadowColor="#99000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="In a world where humanity lives inside cities surrounded by enormous walls..." />

        <LinearLayout
            android:id="@+id/bannerGenresRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/bannerTagsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bannerFormatTag"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:background="@drawable/tag_chip_bg"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                tools:text="TV Series" />

            <TextView
                android:id="@+id/bannerStatusTag"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/tag_chip_bg"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                tools:text="Releasing" />

            <TextView
                android:id="@+id/bannerSeasonTag"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/tag_chip_bg"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                tools:text="winter 2024" />

            <TextView
                android:id="@+id/bannerScoreTag"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/tag_chip_bg"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:textColor="#FFDD44"
                android:textSize="10sp"
                tools:text="85%" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/bannerActionsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/bannerPlayBtn"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:backgroundTint="?attr/colorPrimaryContainer"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:minWidth="96dp"
                android:paddingHorizontal="16dp"
                android:text="@string/watch_now"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/bannerFavBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/tag_chip_bg"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/ic_round_favorite_border_24" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
