<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/syncRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_weight="0">

        <TextView
            android:id="@+id/noSubtitlesNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:alpha="0.7"
            android:text="No subtitles loaded"
            android:textSize="18sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/subtitleSyncRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="4dp"
            tools:listitem="@layout/item_subtitle_sync" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="#33FFFFFF" />

    <TextView
        android:id="@+id/syncTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:fontFamily="@font/poppins_semi_bold"
        android:gravity="center"
        android:text="Subtitle Sync"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/syncStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        tools:text="Offset: 0ms - In sync" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/syncSubtractMore"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:focusable="true"
            android:gravity="center"
            android:text="-1s"
            android:textSize="13sp" />

        <Button
            android:id="@+id/syncSubtract"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.2"
            android:focusable="true"
            android:gravity="center"
            android:text="-100ms"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/syncOffsetInput"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:autofillHints="no"
            android:focusable="true"
            android:gravity="center"
            android:hint="ms"
            android:inputType="numberSigned"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <Button
            android:id="@+id/syncAdd"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.2"
            android:focusable="true"
            android:gravity="center"
            android:text="+100ms"
            android:textSize="12sp" />

        <Button
            android:id="@+id/syncAddMore"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:focusable="true"
            android:gravity="center"
            android:text="+1s"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/syncCancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:focusable="true"
            android:text="Cancel"
            android:textSize="13sp" />

        <Button
            android:id="@+id/syncReset"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:focusable="true"
            android:text="Reset"
            android:textSize="13sp" />

        <Button
            android:id="@+id/syncApply"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:focusable="true"
            android:text="Apply"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
