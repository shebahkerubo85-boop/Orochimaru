<?xml version="1.0" encoding="utf-8"?>
<!--
  The TMDB (movie) mode's Explore page: the anime page plus the streaming-services rail.

  This is the content of the page adapter's single item, so it scrolls inside the
  explore RecyclerView exactly as the anime page does — which is what lets the Franchise
  cards live in the same ConcatAdapter as this page.

  The rows are five includes of one row layout, so every row has the same title/arrow/
  rail treatment and there is no fifth copy to forget to update.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tmdbExploreContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!--
      The same banner the anime explore uses; driven by TmdbMedia instead of AniList.

      Note the chip row below: no fillViewport. fillViewport makes a HorizontalScrollView
      measure itself at the full width of its parent, which quietly overrides
      layout_gravity="center_horizontal" and drops the chips to the left edge. The anime
      season row keeps fillViewport and only looks centred because three long season
      names happen to fill the width; these three short ones do not.
    -->
    <include layout="@layout/layout_trending" />

    <HorizontalScrollView
        android:id="@+id/tmdbExploreTypeScroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="0dp"
        android:clipToPadding="false"
        android:focusable="true"
        android:nextFocusUp="@+id/trendingViewPager"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:scrollbarSize="0dp">

        <LinearLayout
            android:id="@+id/tmdbExploreTypeCont"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Mirrors the season-selector chips exactly so the two pages match. -->
            <com.google.android.material.chip.Chip
                android:id="@+id/tmdbExploreChipMovie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Movie"
                android:textAppearance="@style/SeasonChipLabel"
                app:chipStrokeColor="?attr/colorPrimaryContainer" />

            <com.google.android.material.chip.Chip
                android:id="@+id/tmdbExploreChipTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="TV show"
                android:textAppearance="@style/SeasonChipLabel"
                app:chipStrokeColor="?attr/colorPrimaryContainer" />

            <com.google.android.material.chip.Chip
                android:id="@+id/tmdbExploreChipAnimation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Animation"
                android:textAppearance="@style/SeasonChipLabel"
                app:chipStrokeColor="?attr/colorPrimaryContainer" />
        </LinearLayout>
    </HorizontalScrollView>

    <!--
      The streaming-services rail sits 2dp under the type chips. It has no "Streaming
      Services" header, so the See All that Zangetsu puts beside the title on phone is a
      trailing card in the rail instead (its TV treatment) — the D-pad walks onto it.
      This is the extra row the movie page has over the anime page.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tmdbExploreStreamingRail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:clipToPadding="false"
        android:nextFocusUp="@+id/tmdbExploreTypeScroll"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbarSize="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <include
        android:id="@+id/rowInCinema"
        layout="@layout/item_explore_row" />

    <include
        android:id="@+id/rowTrending"
        layout="@layout/item_explore_row" />

    <include
        android:id="@+id/rowTopRated"
        layout="@layout/item_explore_row" />

    <include
        android:id="@+id/rowLatestRelease"
        layout="@layout/item_explore_row" />

    <include
        android:id="@+id/rowUpcoming"
        layout="@layout/item_explore_row" />

    <!--
      Franchise is a header only, exactly as in anime mode: the cards themselves are a
      separate FranchiseAdaptor in the fragment's ConcatAdapter. The old "Include List"
      switch is gone for now; sort, filter, and content controls go back at the right of
      this title later.
    -->
    <LinearLayout
        android:id="@+id/tmdbFranchiseHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="11dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="invisible">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:padding="8dp"
            android:text="@string/row_franchise"
            android:textSize="16sp" />

        <!--
          Sort pill and direction control sit at the right of the header, as specced.

          The pill shows the selected sort and opens the sort dialog on click; it deliberately has
          no "Sort" label of its own, since the selected value is what identifies it. The
          direction control is a separate button rather than part of the pill, because inverting
          is a distinct action from choosing a sort.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tmdbFranchiseSortPill"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:minWidth="0dp"
            android:text="@string/franchise_sort_random"
            android:textSize="13sp"
            app:icon="@drawable/ic_expand_more"
            app:iconGravity="textEnd"
            app:iconPadding="4dp"
            app:iconSize="18dp"
            tools:ignore="SpUsage" />

        <ImageView
            android:id="@+id/tmdbFranchiseSortDirection"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/franchise_sort_direction"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_sort_direction" />

    </LinearLayout>
</LinearLayout>
