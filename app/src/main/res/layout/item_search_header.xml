<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Row 1: search bar (shrunk) with the filter button to its right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchBar"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="@string/anime"
            android:transitionName="@string/search"
            app:boxBackgroundColor="@color/bg"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="24dp"
            app:boxCornerRadiusBottomStart="24dp"
            app:boxCornerRadiusTopEnd="24dp"
            app:boxCornerRadiusTopStart="24dp"
            app:endIconDrawable="@drawable/ic_round_search_24"
            app:hintAnimationEnabled="true">

            <AutoCompleteTextView
                android:id="@+id/searchBarText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_bold"
                android:imeOptions="actionSearch"
                android:inputType="textPersonName"
                android:padding="8dp"
                android:selectAllOnFocus="true"
                android:textSize="14sp"
                app:boxStrokeColor="@color/text_input_layout_stroke_color"
                tools:ignore="LabelFor,TextContrastCheck" />
        </com.google.android.material.textfield.TextInputLayout>

        <ImageButton
            android:id="@+id/searchFilter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:contentDescription="@string/filter"
            android:focusable="true"
            android:padding="11dp"
            app:srcCompat="@drawable/ic_round_filter_alt_24"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/searchKeyboardToggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@null"
            android:focusable="true"
            android:src="@drawable/ic_round_keyboard_24"
            android:tint="?attr/colorOnSurface"
            android:visibility="gone"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Row 2: clear history and adult, centred -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/clearHistory"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@null"
                android:contentDescription="@string/clear_history"
                android:focusable="true"
                android:padding="11dp"
                app:srcCompat="@drawable/ic_round_history_24"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.65"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="@string/clear_history"
                android:textColor="?attr/colorOnSurface"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/searchAdultCheck"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@null"
                android:contentDescription="@string/adult"
                android:focusable="true"
                android:padding="11dp"
                app:srcCompat="@drawable/ic_round_nsfw_24"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.65"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="@string/adult"
                android:textColor="?attr/colorOnSurface"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchResultLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/search_results"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/searchResultList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.33"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_round_view_list_24"
            app:tint="?attr/colorOnBackground"
            tools:ignore="ContentDescription,ImageContrastCheck" />

        <ImageView
            android:id="@+id/searchResultGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.33"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_round_grid_view_24"
            app:tint="?attr/colorOnBackground"
            tools:ignore="ContentDescription,ImageContrastCheck" />
    </LinearLayout>

    <TextView
        android:id="@+id/searchHistoryLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:alpha="0.65"
        android:fontFamily="@font/poppins_bold"
        android:letterSpacing="0.12"
        android:text="@string/search_history"
        android:textColor="?attr/colorOnSurface"
        android:textSize="11sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/searchHistoryList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:dividerHeight="0dp"
        android:descendantFocusability="afterDescendants"
        tools:listitem="@layout/item_search_history" />

</LinearLayout>