<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/episode_metadata_source"
            android:textColor="?attr/colorPrimary"
            android:textSize="20sp"
            android:paddingBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider" />

        <!-- ─── Anime section header ─── -->
        <LinearLayout
            android:id="@+id/epMetaAnimeRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:background="?android:attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Anime"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/epMetaAnimeChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_round_keyboard_arrow_down_24"
                android:contentDescription="@string/empty" />
        </LinearLayout>

        <!-- Anime expanded content -->
        <LinearLayout
            android:id="@+id/epMetaAnimeExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- AniZip -->
            <LinearLayout
                android:id="@+id/epMetaAniZipRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:minHeight="44dp"
                android:paddingStart="28dp"
                android:paddingEnd="4dp">

                <CheckBox
                    android:id="@+id/epMetaAniZipCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semi_bold"
                        android:text="AniZip"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AniZip episode metadata"
                        android:textColor="?attr/colorOutline"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Kitsu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:minHeight="44dp"
                android:paddingStart="28dp"
                android:paddingEnd="4dp">

                <CheckBox
                    android:id="@+id/epMetaKitsuCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="36dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semi_bold"
                        android:text="Kitsu"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kitsu episode metadata"
                        android:textColor="?attr/colorOutline"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ─── Movie section header ─── -->
        <LinearLayout
            android:id="@+id/epMetaMovieRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:background="?android:attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Movie"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/epMetaMovieChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_round_keyboard_arrow_down_24"
                android:contentDescription="@string/empty" />
        </LinearLayout>

        <!-- Movie expanded content -->
        <LinearLayout
            android:id="@+id/epMetaMovieExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- TMDB -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:minHeight="44dp"
                android:paddingStart="28dp"
                android:paddingEnd="4dp">

                <CheckBox
                    android:id="@+id/epMetaTmdbCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semi_bold"
                        android:text="TMDB"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TMDB movie metadata"
                        android:textColor="?attr/colorOutline"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Simkl -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:minHeight="44dp"
                android:paddingStart="28dp"
                android:paddingEnd="4dp">

                <CheckBox
                    android:id="@+id/epMetaSimklCheck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="36dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semi_bold"
                        android:text="Simkl"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Simkl movie metadata"
                        android:textColor="?attr/colorOutline"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>