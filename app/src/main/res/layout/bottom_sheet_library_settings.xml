<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="26dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/sheetHeaderIconBg"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/sheetHeaderIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_baseline_tune_24"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/anime_list"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins"
                android:text="Sort and filter your library"
                android:textColor="?attr/colorOutline"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sort -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:fontFamily="@font/poppins_semi_bold"
        android:letterSpacing="0.08"
        android:text="SORT BY"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sortRecent"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="@font/poppins_semi_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:nextFocusRight="@id/sortScore"
            android:nextFocusDown="@id/sortTitle"
            android:text="Recently Updated"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_baseline_clock_24"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sortScore"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="@font/poppins_semi_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:nextFocusLeft="@id/sortRecent"
            android:nextFocusDown="@id/sortRelease"
            android:text="Score"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_round_star_graph_24"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="18dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sortTitle"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="@font/poppins_semi_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:nextFocusUp="@id/sortRecent"
            android:nextFocusRight="@id/sortRelease"
            android:nextFocusDown="@id/genreChipGroup"
            android:text="Title"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_round_sort_24"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sortRelease"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="@font/poppins_semi_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:nextFocusUp="@id/sortScore"
            android:nextFocusLeft="@id/sortTitle"
            android:nextFocusDown="@id/genreChipGroup"
            android:text="Release Date"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_round_calendar_today_24"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="18dp" />
    </LinearLayout>

    <!-- Genre / status filter (inline chips, no dialog) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:fontFamily="@font/poppins_semi_bold"
        android:letterSpacing="0.08"
        android:text="FILTER"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:id="@+id/genreChipScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:fillViewport="true"
        android:nextFocusUp="@id/sortTitle"
        android:nextFocusDown="@id/nsfwRow"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/genreChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:alpha="0.18"
        android:background="?attr/colorOutline" />

    <!-- NSFW (anime mode only) -->
    <LinearLayout
        android:id="@+id/nsfwRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_round_nsfw_24"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semi_bold"
                android:text="Show 18+ Content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins"
                android:text="Include adult titles in your library"
                android:textColor="?attr/colorOutline"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/nsfwToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>
</LinearLayout>
