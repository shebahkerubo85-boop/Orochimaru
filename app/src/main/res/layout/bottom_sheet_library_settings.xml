<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:text="Library Settings"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <!-- Sort Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semi_bold"
        android:text="Sort By"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/sortContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sortRecent"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="6dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="Recently Updated"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            tools:ignore="MissingConstraints" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sortScore"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="6dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="Score"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            tools:ignore="MissingConstraints" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sortTitle"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="6dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="Title"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            tools:ignore="MissingConstraints" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sortRelease"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="Release Date"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            tools:ignore="MissingConstraints" />
    </LinearLayout>

    <!-- Genre Filter Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semi_bold"
        android:text="Genre"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/genreFilterBtn"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:text="All"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:layout_marginBottom="20dp"
        app:cornerRadius="12dp"
        tools:ignore="MissingConstraints" />

    <!-- NSFW Toggle -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/nsfwToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:text="Show 18+ Content"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp" />

</LinearLayout>
