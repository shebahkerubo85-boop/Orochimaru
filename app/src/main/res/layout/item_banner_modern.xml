<?xml version="1.0" encoding="utf-8"?>
<!--
  Modern banner: full-bleed cinematic strip. The landscape artwork is the
  background, dimmed by a single overlay drawable (left-to-right wash plus a
  bottom fade) so the logo, synopsis and actions stay legible without hiding the
  art. Metadata lives inside the banner on the left; the portrait poster floats
  on the right.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/banner_modern_height"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:nextFocusUp="@id/mainUserAvatarContainer">

    <ImageView
        android:id="@+id/bannerBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        tools:src="@tools:sample/backgrounds/scenic" />

    <View
        android:id="@+id/bannerModernOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/banner_modern_overlay" />

    <ImageView
        android:id="@+id/bannerModernPoster"
        android:layout_width="@dimen/banner_modern_poster_width"
        android:layout_height="@dimen/banner_modern_poster_height"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="@dimen/banner_modern_poster_margin_end"
        android:background="@drawable/banner_modern_poster_bg"
        android:clipToOutline="true"
        android:elevation="6dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        tools:src="@tools:sample/backgrounds/scenic" />

    <LinearLayout
        android:id="@+id/bannerModernContent"
        android:layout_width="58%"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/banner_modern_content_start"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/bannerClearlogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:maxHeight="64dp"
            android:maxWidth="260dp"
            android:minHeight="40dp"
            android:minWidth="140dp"
            android:scaleType="fitStart"
            android:visibility="gone"
            tools:src="@tools:sample/backgrounds/scenic"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/bannerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppins_bold"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:shadowColor="#99000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="#E6FFFFFF"
            android:textSize="@dimen/banner_modern_title_text"
            android:textStyle="bold"
            tools:text="After the Shibuya Incident, a deadly jujutsu battle" />

        <TextView
            android:id="@+id/bannerDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppins"
            android:lineSpacingExtra="5dp"
            android:maxLines="@integer/banner_modern_synopsis_lines"
            android:shadowColor="#99000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="#DBFFFFFF"
            android:textSize="@dimen/banner_modern_synopsis_text"
            tools:text="After the Shibuya Incident, a deadly jujutsu battle known as the Culling Game begins across Japan." />

        <LinearLayout
            android:id="@+id/bannerMetaRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/bannerActionsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/bannerPlayBtn"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/banner_modern_watch_height"
                android:background="@drawable/banner_modern_pill_bg"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/banner_modern_watch_padding"
                android:stateListAnimator="@null"
                android:text="@string/watch_now"
                android:textAllCaps="false"
                android:textColor="#FF1A1A1A"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
