<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:paddingBottom="8dp"
            android:text="OLED Background"
            android:textColor="?attr/colorPrimary"
            android:textSize="20sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider" />

        <!-- ─── Style options ─── -->
        <RadioGroup
            android:id="@+id/oledModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/oledModeOff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:minHeight="44dp"
                android:text="Off"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/oledModeAmoled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:minHeight="44dp"
                android:text="Pure AMOLED"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/oledModeGlow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:minHeight="44dp"
                android:text="Glow Spots"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/oledModeGradient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:minHeight="44dp"
                android:text="Gradient"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/oledModeVignette"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:minHeight="44dp"
                android:text="Vignette"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="?android:attr/listDivider" />

        <!-- ─── Intensity slider ─── -->
        <include
            android:id="@+id/oledIntensitySlider"
            layout="@layout/item_settings_section_slider" />
    </LinearLayout>
</ScrollView>
