<?xml version="1.0" encoding="utf-8"?>
<!--
  Focused neumorphic card: brighter surface, stronger shadow,
  subtle accent edge for TV/dpad visibility at a distance.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Stronger shadow layer -->
    <item
        android:bottom="4dp"
        android:right="2dp"
        android:left="2dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#121212" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Brighter highlight layer -->
    <item
        android:top="1dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#343434" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>

    <!-- Elevated surface — brighter than unfocused -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/charcoal_card_focused" />
            <corners android:radius="18dp" />
        </shape>
    </item>

</layer-list>
