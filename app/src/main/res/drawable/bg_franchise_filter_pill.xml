<?xml version="1.0" encoding="utf-8"?>
<!--
  The track the filter chips sit in.

  The chips draw their own filled or outlined state, so this is only the rounded container.
  A wash rather than a solid, so on the page's flat background it reads as a groove for the
  chips rather than as a bar of its own.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/franchise_art_pill" />
    <corners android:radius="20dp" />
</shape>
