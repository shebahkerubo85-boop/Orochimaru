<?xml version="1.0" encoding="utf-8"?>
<!--
  The track the filter chips sit in. The chips are Material Chips and draw their own filled or
  outlined state, so this is only the rounded container around them, not a state drawable itself.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#59000000" />
    <corners android:radius="20dp" />
</shape>
