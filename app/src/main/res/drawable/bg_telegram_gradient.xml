<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#FF050505"
                android:centerColor="#FFD0D0D0"
                android:endColor="#FFFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:width="80dp"
        android:height="300dp"
        android:gravity="center">
        <rotate
            android:fromDegrees="-25"
            android:toDegrees="-25"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="#002AABEE"
                    android:centerColor="#CC2AABEE"
                    android:endColor="#002AABEE" />
                <corners android:radius="60dp" />
            </shape>
        </rotate>
    </item>
</layer-list>
