<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="3dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#26000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="#3D000000"
                android:centerColor="#18000000"
                android:endColor="#00000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <stroke android:width="1dp" android:color="#26000000" />
            <corners android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp"
                android:topLeftRadius="16dp" android:topRightRadius="16dp" />
        </shape>
    </item>
</layer-list>
