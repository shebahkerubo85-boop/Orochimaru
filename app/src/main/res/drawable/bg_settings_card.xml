<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings card with top rim highlight.
  Uses inset layering: a gradient background peeks through
  at the top as a 1dp rim highlight.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bottom shadow -->
    <item
        android:bottom="3dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#15000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Gradient rim layer: shows through as top border -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#44FFFFFF"
                android:centerColor="#18FFFFFF"
                android:endColor="#00000000"
                android:type="linear" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Card surface: inset 1dp so gradient peeks at top as rim -->
    <item
        android:bottom="0dp"
        android:left="0dp"
        android:right="0dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceVariant" />
            <corners android:bottomLeftRadius="16dp"
                android:bottomRightRadius="16dp"
                android:topLeftRadius="15dp"
                android:topRightRadius="15dp" />
        </shape>
    </item>

</layer-list>
