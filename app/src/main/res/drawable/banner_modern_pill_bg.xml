<?xml version="1.0" encoding="utf-8"?>
<!--
  Matches the other banner actions (tag_chip_bg): a faint translucent wash so the
  artwork shows through. Kept as a pill rather than tag_chip_bg's 12dp radius,
  since that is the Modern banner's shape language.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="100dp" />
    <solid android:color="#1A000000" />
</shape>
