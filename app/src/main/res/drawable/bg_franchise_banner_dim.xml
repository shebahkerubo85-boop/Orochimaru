<?xml version="1.0" encoding="utf-8"?>
<!--
  Flat wash over the franchise banner. The banner is already a dimmed, low-contrast
  backdrop behind the poster row and the title, so it only needs enough black to keep
  the white year and title readable. No blur: the art stays sharp behind the wash.

  Darkened once the card was made taller: at the old height the art read as a bright band
  above the posters, and a taller card made that band larger rather than calmer, so the
  wash is now heavier at the top and bottom and lightest in the middle where the year and
  title sit. The middle is what has to stay legible, so it is the one value left comparatively
  clear.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:centerColor="#A6000000"
        android:centerY="0.35"
        android:endColor="#B3000000"
        android:startColor="#B3000000"
        android:type="linear" />
</shape>
