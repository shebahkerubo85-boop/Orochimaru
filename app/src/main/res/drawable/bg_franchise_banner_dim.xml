<?xml version="1.0" encoding="utf-8"?>
<!--
  Flat wash over the franchise banner. The banner is already a dimmed, low-contrast
  backdrop behind the poster row and the title, so it only needs enough black to keep
  the white year and title readable. No blur: the art stays sharp behind the wash.

  Darkened at the user's request, twice. The bottom stop carries the most weight of the three
  because the title now sits 1dp off the card's bottom edge, so it is white text with
  almost no air under it, and the middle is left the clearest of the three because that is
  where the year has to stay readable over whatever artwork happens to be behind it.

  The wash is heavier now than the earlier request asked for: the poster row behind it was the
  one thing still reading as a second, brighter layer competing with the title rather than as
  artwork sitting under it. 60% at the edges with the middle held at 35% buries the art without
  turning the band into a flat black plate, because the middle is never fully closed.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:centerColor="#59000000"
        android:centerY="0.35"
        android:endColor="#99000000"
        android:startColor="#99000000"
        android:type="linear" />
</shape>
